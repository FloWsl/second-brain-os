{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command",
          "command": "cat \"$CLAUDE_PROJECT_DIR/hot.md\"; cd \"$CLAUDE_PROJECT_DIR\" && python3 brain.py lint | tail -6" }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect.sh\"" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.sh\"" }] }
    ]
  }
}
